{
  "expo": {
    "name": "Asian Le Rewards",
    "slug": "asian-le-rewards",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "asianlerewards",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.buivuanhhuy.AsianLeRewards"
    },
    "android": {
      "package": "com.buivuanhhuy.AsianLeRewards",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fd88f6fa-6047-44d2-94c6-4270964ad29e"
      }
    },
    "owner": "buivuanhhuy"
  }
}
