{
  "expo": {
    "name": "Asian Le Rewards",
    "slug": "asian-le-rewards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "asianlerewards",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.buivuanhhuy.AsianLeRewards",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1C1611"
      },
      "package": "com.buivuanhhuy.AsianLeRewards",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1611",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "android": {
            "image": "./assets/images/splash-icon-android.png",
            "imageWidth": 288
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fd88f6fa-6047-44d2-94c6-4270964ad29e"
      }
    },
    "owner": "buivuanhhuy"
  }
}
