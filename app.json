{
  "expo": {
    "name": "Asian Le Rewards",
    "slug": "asian-le-rewards",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "asianlerewards",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
