# Loyalty Firebase project — Project settings → Your apps → Web app config.
# Used on web, iOS and Android.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google sign-in (Firebase → Authentication → Google, and Google Cloud → Credentials).
# Web client ID: used on web and by the iOS/Android library to get a Firebase-usable token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID, and the same ID reversed (com.googleusercontent.apps.…) for the URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
